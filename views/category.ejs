<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= category %> - RajaTopUp</title>

<link rel="stylesheet" href="/css/style.css">

</head>
<body>

<header class="topbar">
    <h2>🎮 <%= category %></h2>
</header>

<div class="category-grid">

<% brands.forEach(brand => { %>

<%
let logo = "/images/default.png";

switch(brand.toUpperCase()){

case "FREE FIRE":
logo="/images/games/freefireLogo.png";
break;

case "MOBILE LEGENDS":
logo="/images/games/mlbblogo.png";
break;

case "AXIS":
logo="/images/pulsa/axis.png";
break;

case "BY.U":
logo="/images/pulsa/byu.png";
break;

case "TELKOMSEL":
logo="/images/pulsa/telkomsel.png";
break;

case "INDOSAT":
logo="/images/pulsa/indosat.png";
break;

case "SMARTFREN":
logo="/images/pulsa/smartfren.png";
break;

case "TRI":
logo="/images/pulsa/tri.png";
break;

case "XL":
logo="/images/pulsa/xl.png";
break;

case "PLN":
logo="/images/pln/pln.png";
break;

case "TOKEN PLN":
logo="/images/pln/pln.png";
break;

}
%>

<a class="category-card"
href="/category/<%= category %>/<%= encodeURIComponent(brand) %>">

<img src="<%= logo %>" class="category-image">

<h3><%= brand %></h3>

</a>

<% }) %>

</div>

</body>
</html>
