<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= category %> - RajaTopUp</title>

<link rel="stylesheet" href="/css/style.css">

</head>
<body>

<header class="topbar">
    <h2>🎮 <%= category %></h2>
</header>

<div class="category-grid">

<% brands.forEach(brand => { %>

<%
let logo="/images/games/freefireLogo.png";

if(brand.toUpperCase().includes("MOBILE")){
    logo="/images/games/mlbblogo.png";
}
%>

<a class="category-card"
href="/category/<%= category %>/<%= encodeURIComponent(brand) %>">

<img src="<%= logo %>" class="category-image">

<h3><%= brand %></h3>

</a>

<% }) %>

</div>

</body>
</html>
