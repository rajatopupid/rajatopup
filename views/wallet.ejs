    </div>

    <div class="wallet-box">

        <h3>Status</h3>

        <p>
            <%= wallet ? wallet.level.toUpperCase() : "REGULAR" %>
        </p>

    </div>

    <div class="wallet-box">

        <h3>Riwayat</h3>

        <p>Belum ada transaksi.</p>

    </div>

</div>

<%- include("partials/footer") %>
