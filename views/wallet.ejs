                📋 Salin
            </button>

        </div>

        <small>
            Gunakan ID ini untuk menerima saldo RajaTopUp.
        </small>

    </div>

    <div class="wallet-box">

        <h3>Saldo Token</h3>

        <h1>
            Rp <%= wallet ? Number(wallet.saldo).toLocaleString("id-ID") : 0 %>
