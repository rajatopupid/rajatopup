<!DOCTYPE html>
<html lang="id">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

Kelola Produk

</title>

<link
rel="stylesheet"
href="/css/style.css">

</head>

<body>

<div class="admin-layout">

<aside class="sidebar">

<h2>

👑 RajaTopUp

</h2>

<a href="/admin/dashboard">

🏠 Dashboard

</a>

<a href="/admin/products">

📦 Produk

</a>

<a href="/admin/product/add">

➕ Tambah Produk

</a>

<a href="/">

🌐 Website

</a>

</aside>

<main class="content">

<div class="topbar">

<div>

<h1>📦 Kelola Produk</h1>

<p style="color:#777;margin-top:5px;">
Kelola seluruh produk RajaTopUp
</p>

</div>

<div class="action-group">

<a
class="btn"
href="/admin/product/add">

➕ Tambah Produk

</a>

<a
class="btn btn-success"
href="/admin/products/add-new">

🆕 Tambah Produk Baru

</a>

<a
class="btn btn-warning"
href="/admin/products/update-price">

💰 Update Harga Modal

</a>

</div>

</div>

<% if (req.query.new) { %>

<div class="alert-success">

✅ Berhasil menambahkan
<b><%= req.query.new %></b>
produk baru dari Digiflazz.

</div>

<% } %>

<% if(req.query.update){ %>

<div class="alert-success">

💰 Berhasil memperbarui
<b><%= req.query.update %></b>
harga modal.

</div>

<% } %>

<div class="dashboard-grid">

<div class="box">

<h3>Total Produk</h3>

<h2><%= products.length %></h2>

</div>

<div class="box">

<h3>Produk Aktif</h3>

<h2><%= products.filter(x=>x.status).length %></h2>

</div>

<div class="box">

<h3>Produk Nonaktif</h3>

<h2><%= products.filter(x=>!x.status).length %></h2>

</div>

</div>

<div class="filter-box">

<input
type="text"
id="searchInput"
placeholder="🔍 Cari produk..."
onkeyup="searchProduct()">

</div>

<table class="table">

<thead>

<tr>

<th>

Game

</th>

<th>

Produk

</th>

<th>

Kode

</th>

<th>

Modal

</th>

<th>

Jual

</th>

<th>

Status

</th>

<th>

Aksi

</th>

</tr>

</thead>

<tbody>

<% if(products.length===0){ %>

<tr>

<td
colspan="7"
style="text-align:center">

Belum ada produk

</td>

</tr>

<% } %>

<% products.forEach(p=>{ %>

<tr>

<td style="color:#000">
<%= String(p.game) %>
</td>

<td style="color:#000">
<%= String(p.nama) %>
</td>

<td style="color:#000">
<%= String(p.kode) %>
</td>

<td style="color:#000">
Rp <%= p.harga_modal %>
</td>

<td style="color:#000">
Rp <%= p.harga_jual %>
</td>

<td>

<% if(p.status){ %>

<span class="badge-active">

Aktif

</span>

<% }else{ %>

<span class="badge-disable">

Nonaktif

</span>

<% } %>

</td>

<td>

<a
class="btn-small"

href="/admin/product/edit/<%= p.id %>">

✏ Edit

</a>

<a
class="btn-small-danger"

onclick="return confirm('Hapus produk ini?')"

href="/admin/product/delete/<%= p.id %>">

🗑 Hapus

</a>

</td>

</tr>

<% }) %>

</tbody>

</table>

</main>

</div>

<script>

function searchProduct(){

const keyword=document
.getElementById("searchInput")
.value
.toLowerCase();

const rows=document.querySelectorAll("tbody tr");

rows.forEach(row=>{

row.style.display=
row.innerText.toLowerCase().includes(keyword)
?"":"none";

});

}

</script>

</body>

</html>
